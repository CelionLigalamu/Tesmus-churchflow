# Copy this file to .env and fill in the values. Never commit .env.

# --- Django -----------------------------------------------------------------
# True only on a developer's PC. Leave unset (or False) on the live server.
DJANGO_DEBUG=False
# A long random value, different for every server. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Domain names the site is served on, separated by commas.
DJANGO_ALLOWED_HOSTS=churchflow.example.com
# The same domains with https://, separated by commas.
DJANGO_CSRF_TRUSTED_ORIGINS=https://churchflow.example.com
# Optional: set to False only if the web server already redirects HTTP to HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=True
# Optional: how long browsers must insist on HTTPS, in seconds.
# DJANGO_SECURE_HSTS_SECONDS=3600

# --- PostgreSQL -------------------------------------------------------------
# Leave POSTGRES_DB empty on a developer's PC to use the local SQLite file instead.
POSTGRES_DB=churchflow
POSTGRES_USER=churchflow
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use "require" when the database is on another machine or a managed service.
POSTGRES_SSLMODE=prefer
# Seconds a database connection is reused (0 opens a new one for every request).
POSTGRES_CONN_MAX_AGE=60

# --- Cloudinary (uploaded logos and photos) ---------------------------------
# Leave empty on a developer's PC to save uploads in the media folder.
# Copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=

# --- Africa's Talking SMS ---------------------------------------------------
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
